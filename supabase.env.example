WOOVI_PROD_BASE_URL=https://api.woovi.com
WOOVI_PROD_APP_ID=
WOOVI_PROD_WEBHOOK_SECRET=
# Backward-compatible generic names; use only if the target-specific names above
# are not filled in.
WOOVI_ENVIRONMENT=
WOOVI_BASE_URL=
WOOVI_APP_ID=
WOOVI_WEBHOOK_SECRET=
